# 5. NEW FUNCTION: CALCULATE FIGHT IMPORTANCE
def calculate_fight_importance(r_fighter_elo, b_fighter_elo, title_implications=False, 
                                streak_multiplier=1.0, rivalry_multiplier=1.0,
                                ranking_position=0, event_prestige=1.0):
    """
    Calculate the importance of a fight to a match based on multiple factors
    
    Parameters:
    - r_fighter_elo, b_fighter_elo: Current Elo ratings
    - title_implications: Boolean for title shot implications
    - streak_multiplier: Win streak impact (1.0 = normal)
    - rivalry_multiplier: Historical rivalry impact (1.0 = normal)
    - ranking_position: Combined ranking of fighters (lower = more important)
    - event_prestige: PPV/Prelim multiplier (1.0 = normal)
    
    Returns:
    - importance_score: 0-100 scale
    - breakdown: Dictionary of individual factor scores
    """
    # Elo quality factor (higher ranked fighters = more important)
    avg_elo = (r_fighter_elo + b_fighter_elo) / 2
    elo_quality = min(100, (avg_elo - 1200) / 4)  # 1200 is beginner, 2000+ is elite
    elo_quality = max(0, elo_quality)
    
    # Elo competitiveness factor (close matches are more important)
    elo_diff = abs(r_fighter_elo - b_fighter_elo)
    competitiveness = max(0, 100 - (elo_diff / 8))  # 0 diff = 100, 800 diff = 0
    competitiveness = min(100, competitiveness)
    
    # Title implications factor
    title_factor = 40 if title_implications else 0
    
    # Streak factor (more weight for fighters on streaks)
    streak_factor = streak_multiplier * 20
    streak_factor = min(20, streak_factor)
    
    # Rivalry factor
    rivalry_factor = rivalry_multiplier * 15
    rivalry_factor = min(15, rivalry_factor)
    
    # Ranking factor (top 15 is important)
    ranking_factor = max(0, 20 - (ranking_position / 2))
    ranking_factor = min(20, ranking_factor)
    
    # Event prestige factor
    prestige_factor = event_prestige * 10
    
    # Total importance score
    importance_score = (elo_quality * 0.25 +  # 25% weight
                       competitiveness * 0.25 +  # 25% weight
                       title_factor +  # 40% max
                       streak_factor +  # 20% max
                       rivalry_factor +  # 15% max
                       ranking_factor +  # 20% max
                       prestige_factor)  # 10% max
    
    importance_score = min(100, importance_score)
    
    breakdown = {
        'Fighter Quality (Elo)': round(elo_quality, 2),
        'Competitiveness': round(competitiveness, 2),
        'Title Implications': title_factor,
        'Win Streaks': round(streak_factor, 2),
        'Rivalry': round(rivalry_factor, 2),
        'Ranking Impact': round(ranking_factor, 2),
        'Event Prestige': round(prestige_factor, 2)
    }
    
    return importance_score, breakdown

