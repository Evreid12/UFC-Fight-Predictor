# 7. SIMULATION FOR SEAN STRICKLAND VS KHAMZAT CHIMAEV
def simulate_fight(r_fighter, b_fighter, r_stats, b_stats, model, feature_list, n_simulations=10000):
    """
    Monte Carlo simulation for a specific fight
    """
    print("\n" + "="*60)
    print(f"SIMULATION: {r_fighter} vs {b_fighter}")
    print("="*60)
    
    # Create feature array for prediction
    features = np.array([[
        r_stats['elo'], b_stats['elo'], r_stats['elo'] - b_stats['elo'],
        r_stats['age'], b_stats['age'],
        r_stats['height'], b_stats['height'],
        r_stats['reach'], b_stats['reach'],
        r_stats['sig_str_acc'], b_stats['sig_str_acc']
    ]])
    
    # Get base probability
    base_prob = model.predict_proba(features)[0][1]  # Probability Blue wins
    
    # Monte Carlo simulation with variance
    sim_results = []
    for _ in range(n_simulations):
        # Add some variance to simulate fight outcomes
        variance = np.random.normal(0, 0.05)  # 5% standard deviation
        sim_prob = base_prob + variance
        sim_prob = np.clip(sim_prob, 0, 1)
        
        # Determine winner
        outcome = np.random.random() < sim_prob
        sim_results.append(1 if outcome else 0)  # 1 = Blue wins, 0 = Red wins
    
    blue_win_pct = np.mean(sim_results) * 100
    red_win_pct = 100 - blue_win_pct
    
    # Calculate confidence intervals
    confidence_interval = np.percentile(sim_results, [2.5, 97.5]) * 100
    
    print(f"\n📊 Monte Carlo Results (based on {n_simulations:,} simulations):")
    print(f"   {r_fighter}: {red_win_pct:.1f}% win probability")
    print(f"   {b_fighter}: {blue_win_pct:.1f}% win probability")
    print(f"\n95% Confidence Interval for {b_fighter}: {confidence_interval[0]:.1f}% - {confidence_interval[1]:.1f}%")
    
    # Fight outcome scenarios
    print("\n🎲 Most Likely Scenarios:")
    if blue_win_pct > 60:
        print(f"   ✓ {b_fighter} is the clear favorite")
        print(f"   ✓ Expected method: Decision or Late TKO")
    elif blue_win_pct > 50:
        print(f"   ✓ {b_fighter} is a slight favorite")
        print(f"   ✓ Competitive fight expected")
    elif red_win_pct > 60:
        print(f"   ✓ {r_fighter} is the clear favorite")
        print(f"   ✓ Expected method: Decision or Late TKO")
    else:
        print(f"   ✓ Extremely competitive matchup")
        print(f"   ✓ Could go either way")
    
    return {'red_win': red_win_pct, 'blue_win': blue_win_pct}

